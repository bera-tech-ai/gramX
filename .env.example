# Server runtime
NODE_ENV=production
PORT=3000
DB_NAME=gramXDB

# MongoDB Atlas or another private MongoDB deployment
MONGODB_URI=

# Required admin identity; use a unique password of at least 16 characters
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Reserved for future signed-token integrations; never use the placeholder in production
JWT_SECRET=

# WebRTC: STUN is optional; TURN is strongly recommended for production calls
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
